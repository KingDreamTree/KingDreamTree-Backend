# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── VLM provider (확정 후 입력) ───────────────────────────────────────────
# 지원 값: claude | openai | (추후 추가)
VLM_PROVIDER=
ANTHROPIC_API_KEY=   # VLM_PROVIDER=claude 일 때 필요
OPENAI_API_KEY=      # VLM_PROVIDER=openai 일 때 필요 (미구현)

# ── Sapiens2 모델 경로 ────────────────────────────────────────────────────
# 로컬: models/ 디렉토리에 가중치 배치 (scripts/download_sapiens.py 참고)
# Docker: docker-compose가 ./models:/app/models 로 마운트
MODEL_DIR=models

# ── 개발 모드 ─────────────────────────────────────────────────────────────
# true 로 설정하면 모든 외부 호출 없이 mock 데이터 반환
USE_MOCK=
