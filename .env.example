# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → Data API → Project URL  (끝에 /rest/v1 붙이지 말 것)
SUPABASE_URL=
# Project Settings → API Keys → Publishable key (구 anon)
# 프론트가 Supabase에 직접 붙지 않으므로 서버에서는 쓰지 않는다. 비워둬도 됨.
SUPABASE_ANON_KEY=
# Project Settings → API Keys → Secret keys → sb_secret_...  (구 service_role)
# ⚠️ RLS를 전부 우회한다. 서버 사이드 전용, 프론트에 절대 노출 금지.
SUPABASE_SERVICE_ROLE_KEY=

# ── Storage 버킷 (전부 private) ─────────────────────────────────────────────
BUCKET_PHOTOS=photos
BUCKET_SEGMENTATIONS=segmentations
BUCKET_BODY_PARTS=body-parts
BUCKET_INBODY_TEMP=inbody-temp
SIGNED_URL_EXPIRES_SEC=3600
SIGNED_URL_MAX_BATCH=30

# ── 업로드 제한 ─────────────────────────────────────────────────────────────
MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_SIDE=4096
INBODY_MAX_FILES=5

# ── 1차 검사: 포즈 판정 ─────────────────────────────────────────────────────
# 산식과 각 값의 근거: docs/pose-scoring.md
# ⚠️ 프론트가 GET /api/v1/pose-criteria 로 이 값들을 받아 쓴다. 여기만 고치면 된다.
POSE_THRESHOLD=70.0
FRAMING_F_MIN=0.65
POSE_TOL_DEG=45.0
POSE_HARD_TOL_DEG=60.0
POSE_FACING_MAX_DELTA=0.25
POSE_MIN_VISIBLE_ANGLES=4
POSE_MIN_VISIBILITY=0.5
POSE_N_HOLD=15

# ── 세그멘테이션 (⚠️ 전부 튜닝 대상 잠정값) ─────────────────────────────────
SEG_MIN_PIXELS=1500
SEG_MIN_RATIO=0.005
MAP_MAX_SIDE=1024

# 업로드 시 VLM 으로 사진 적합성을 판정할지 (몸에 붙는 옷이라 실루엣이 보이는가).
# ⚠️ 동기 호출이라 업로드가 2~5초 느려진다. 재촬영을 그 자리에서 유도하기 위함이다.
# ⚠️ 판정 실패·타임아웃은 통과로 처리한다 — 업로드가 통째로 막히면 시연이 멈춘다.
#    OPENAI_API_KEY 가 없거나 USE_MOCK=true 면 자동으로 건너뛴다.
PHOTO_SCREENING_ENABLED=true
PHOTO_SCREENING_TIMEOUT_SEC=10.0
# 판정에 보낼 이미지 긴 변 상한 (원본 그대로 보내면 토큰 낭비)
PHOTO_SCREENING_MAX_SIDE=768
MIN_COMPARABLE_PARTS=3

# ── 잡 큐 / 워커 ────────────────────────────────────────────────────────────
JOB_MAX_ATTEMPTS=3
JOB_CLAIM_RETRIES=5
WORKER_POLL_INTERVAL_SEC=1.0

# PROCESSING 인 채로 이 시간이 지나면 워커가 죽은 것으로 보고 회수한다.
# ⚠️ 가장 오래 걸리는 잡보다 넉넉히 길게 잡을 것. 짧으면 멀쩡히 돌고 있는 잡을
#    회수해 같은 일을 두 번 한다 (VLM이면 요금도 두 배).
JOB_STALE_AFTER_SEC=900
JOB_RECLAIM_INTERVAL_SEC=60
# ⚠️ SEG/VLM_WORKER_CONCURRENCY 는 제거했다. 넣어도 무시된다.
#    VLM: 부위 진단이 잡 1개로 전 부위를 처리하므로 조절할 동시성이 없다.
#    SEG: 애초에 배선돼 있지 않았다 (run.py 는 단일 루프).
#    docs/removed-code.md 참고.

# ── Sapiens2 (세그멘테이션 워커 전용) ───────────────────────────────────────
# 가중치는 git에 없다. scripts/download_sapiens.py 참고.
MODEL_DIR=models

# 백본 크기: 0.4b | 0.8b | 1b | 5b
#   운영/시연  → 5b   (RunPod, VRAM 24GB 권장. fp16 가중치만 ~9.5GB)
#   로컬 개발  → 0.4b (VRAM 8GB면 1b까지 가능)
# ⚠️ 라벨 목록은 sapiens2-seg 계열 공식 문서 기준이다
#    (sapiens_labels.SUPPORTED_MODELS). 목록에 없는 모델로 돌리면 워커가
#    기동을 거부한다 — 클래스 순서가 다를 수 있고, 틀려도 에러 없이 진행된다.
SAPIENS_SIZE=5b

# auto | cuda | cpu
SAPIENS_DEVICE=auto
# auto | float16 | bfloat16 | float32   (CPU에서 float16은 오히려 느리다)
SAPIENS_DTYPE=auto

# VRAM보다 큰 모델을 CPU로 흘려보내며 돌릴지 (accelerate device_map).
# ⚠️ 8GB VRAM에서 5b를 보려는 경우에만 true. 느리다. 운영에서는 false.
SAPIENS_OFFLOAD=false
# 오프로딩 시 GPU에 최대 몇 GiB까지. 0이면 자동(전체의 90%)
SAPIENS_GPU_MAX_GIB=0

# ⚠️ 라벨 목록이 확인되지 않은 모델이면 워커 기동을 거부한다.
#    false 로 두면 클래스 순서가 다른 모델도 그냥 돌아 부위가 통째로 어긋난다.
SAPIENS_STRICT_LABELS=true

# ── VLM provider (담당 B 영역, 확정 후 입력) ────────────────────────────────
# 지원 값: claude | openai
VLM_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── 개발 모드 ───────────────────────────────────────────────────────────────
USE_MOCK=
