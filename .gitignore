# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment files
.env
.env.*
!.env.example

# Model weights — never commit
*.pt
*.pth
*.safetensors
*.onnx
*.task
models/*
!models/.gitkeep

# Secrets / certs
*.pem
*.key
*.crt

# Local scratch
uploads/
overlays/
tmp/
# scripts/verify_labels.py 산출물 (사람 사진이 들어간 오버레이 — 절대 커밋 금지)
# ⚠️ out/ 만 막으면 --out out_run1 처럼 다른 이름을 주는 순간 뚫린다.
out*/

# 검증용으로 리포 루트에 떨어뜨린 사람 사진.
# ⚠️ 앞의 `/` 가 중요하다 — 확장자를 전역으로 막으면 docs/ 에 스크린샷을 추가할 때
#    git add 가 조용히 아무것도 안 한다. 에러도 안 난다. 딱 루트만 막는다.
/*.jpg
/*.jpeg
/*.png
/*.heic

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS
.DS_Store
Thumbs.db

# Coverage / testing
.pytest_cache/
.coverage
htmlcov/

# Mypy
.mypy_cache/

# ExerciseDB 배치 수집 캐시 (fetch_exercisedb.py 산출물 — 재수집 가능)
# ⚠️ 디렉터리째 무시하면(/data/) 하위 예외(!)가 먹지 않는다 — git 이 디렉터리
#    단계에서 가지치기하기 때문. 그래서 파일 단위로 무시하고 카탈로그만 살린다.
/data/*
# 루틴 카탈로그는 예외 — 없으면 루틴 생성이 죽는데 재수집엔 API 키가 필요해서,
# clone 만으로 돌아가야 한다 (EC2 배포·신규 합류자).
!/data/exercise_catalog.json

# 2차 검사 시험용 사진 (scripts/verify_photo_screening.py)
# 실제 사람 몸 사진이다. 절대 커밋하지 말 것.
photos/

# 임계값 측정용 사진 (scripts/measure_pose_tolerance.py)
# 실제 사람 몸 사진이다. 절대 커밋하지 말 것.
tolerance/

# 리포 루트에 굴러다니는 실사진 — 진단문 품질을 눈으로 볼 때 각자 로컬에 둔다.
# ⚠️ 커밋하면 재배포다. 출처를 알 수 없는 사진이든 본인 사진이든, 한 번
#    커밋되면 파일을 지워도 히스토리에 영구히 남는다.
#    스모크가 쓰는 픽스처는 합성 이미지다 (scripts/make_fixture_photo.py).
/*.jpg
/*.jpeg
/*.png
!tests/fixtures/*
