# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
.venv/
venv/
env/

# Environment files
.env
.env.*
!.env.example

# Model weights — never commit
*.pt
*.pth
*.safetensors
*.onnx
*.task
models/*
!models/.gitkeep

# Secrets / certs
*.pem
*.key
*.crt

# Local scratch
uploads/
overlays/
tmp/
# scripts/verify_labels.py 산출물 (사람 사진이 들어간 오버레이 — 절대 커밋 금지)
# ⚠️ out/ 만 막으면 --out out_run1 처럼 다른 이름을 주는 순간 뚫린다.
out*/

# 검증용으로 리포 루트에 떨어뜨린 사람 사진.
# ⚠️ 앞의 `/` 가 중요하다 — 확장자를 전역으로 막으면 docs/ 에 스크린샷을 추가할 때
#    git add 가 조용히 아무것도 안 한다. 에러도 안 난다. 딱 루트만 막는다.
/*.jpg
/*.jpeg
/*.png
/*.heic

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr

# OS
.DS_Store
Thumbs.db

# Coverage / testing
.pytest_cache/
.coverage
htmlcov/

# Mypy
.mypy_cache/

# 2차 검사 시험용 사진 (scripts/verify_photo_screening.py)
# 실제 사람 몸 사진이다. 절대 커밋하지 말 것.
photos/

# 임계값 측정용 사진 (scripts/measure_pose_tolerance.py)
# 실제 사람 몸 사진이다. 절대 커밋하지 말 것.
tolerance/
