# HTTPS 리버스 프록시 설정.
#
# 아래 도메인을 실제 것으로 바꾸면 Caddy 가 Let's Encrypt 인증서를 자동으로
# 발급·갱신한다. certbot·cron 불필요. 조건: 도메인이 이 서버의 탄력적 IP 를
# 가리키고, 보안그룹에서 80·443 이 열려 있을 것.
#
# ⚠️ 도메인 없이 IP 로는 정식 인증서를 못 받는다.
# ⚠️ http(80) 요청은 Caddy 가 자동으로 https 로 리다이렉트한다.
#
# api.refit.live — 가비아 DNS 의 A 레코드(호스트 api)가 EC2 탄력적 IP 를 가리킨다.
#
# 무중단 배포 (2026-09-09): API 컨테이너가 api_a·api_b 둘이다.
#   · lb_policy first     — 평소엔 api_a 로만 보낸다 (둘 다 살아 있으면 순서대로 첫 번째).
#   · health_uri /health  — 3초마다 능동 확인. 재시작 중인 쪽은 목록에서 빠진다.
#   · lb_try_duration     — 연결이 막 끊긴 순간의 요청은 다른 쪽으로 다시 시도한다.
#   그래서 scripts/deploy_rolling.sh 가 하나씩 갈아끼우는 동안 502 가 나지 않는다.

api.refit.live {
    reverse_proxy api_a:8000 api_b:8000 {
        lb_policy first
        lb_try_duration 8s
        lb_try_interval 250ms
        health_uri /health
        health_interval 3s
        health_timeout 3s
        fail_duration 10s
    }
}
